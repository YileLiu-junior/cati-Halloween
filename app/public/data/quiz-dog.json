      "options": [
        { "id": "q5a", "text": "生物钟精确得像上班：到点催饭、到点催遛，一天不差，比闹钟好使", "axis": "C", "delta": 3, "points": { "franken": 2, "pharaoh": 1, "witch": 1 } },
        { "id": "q5b", "text": "你难过掉眼泪的时候，它会把脑袋搁在你膝盖上，安静陪着", "axis": "A", "delta": 3, "points": { "nurse": 2, "bride": 1 } },
        { "id": "q5c", "text": "毫无预兆突然在家里狂奔三圈（zoomies），跑完若无其事", "axis": "E", "delta": 3, "points": { "werewolf": 2, "clown": 1, "chainsaw": 1 } },
        { "id": "q5d", "text": "你干蠢事的时候它用一种很稳的眼神看你，眼里没有一丝波澜", "axis": "D", "delta": -3, "points": { "gargoyle": 2, "vampire": 1 } }
      ]
