        { "id": "q3b", "text": "它睡在你床边/枕头上，一夜没挪窝，呼噜比你响", "axis": "A", "delta": 3, "points": { "bride": 2, "nurse": 1 } },
        { "id": "q3c", "text": "你起夜上厕所，黑暗里它已经坐好抬头盯着你，尾巴礼貌地扫两下", "axis": "C", "delta": 3, "points": { "witch": 3, "franken": 1 } },
        { "id": "q3d", "text": "半夜突然对着窗外/空气低吼两声，吓得你瞬间清醒", "axis": "B", "delta": 3, "points": { "bat": 2, "pirate": 1, "clown": 1 } }
      ]
    },
