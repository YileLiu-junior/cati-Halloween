  "questions": [
    {
      "id": "q1",
      "scene": "下班开门",
      "text": "你开门回家的那一刻，你家狗在干嘛？",
      "options": [
        { "id": "q1a", "text": "门还没开完就已经在门后蹦跳，尾巴摇成螺旋桨，还要叼双拖鞋来献给你", "axis": "A", "delta": 3, "points": { "nurse": 2, "bride": 1, "zombie": 1 } },
        { "id": "q1b", "text": "门外一有脚步声就躲到沙发底下，等你确认安全才探头出来", "axis": "B", "delta": -3, "points": { "mummy": 2, "ghost": 1 } },
        { "id": "q1c", "text": "抬眼看了你一下，「哦，回来了」，尾巴拍两下地板，继续趴着", "axis": "A", "delta": -3, "points": { "vampire": 2, "pharaoh": 1 } },
        { "id": "q1d", "text": "四脚朝天睡得雷打不动，你换完鞋它还没醒", "axis": "E", "delta": -3, "points": { "gargoyle": 2, "pharaoh": 1, "bat": 1 } }
      ]
    },
    {
      "id": "q2",
      "scene": "开饭时刻",
      "text": "狗粮倒进碗里 / 撕开零食包装的瞬间——",
      "options": [
        { "id": "q2a", "text": "听见袋子响瞬移到场，5 秒吃完，然后盯着你的嘴看：「你嘴里有我的份吗？」", "axis": "F", "delta": 3, "points": { "pumpkin": 3 } },
        { "id": "q2b", "text": "闻一下就走，「本汪今天心情不适合吃这个」", "axis": "F", "delta": -3, "points": { "pharaoh": 2, "vampire": 1, "witch": 1 } },
        { "id": "q2c", "text": "必须你在旁边陪着才肯吃，吃一口抬头看你一眼", "axis": "A", "delta": 3, "points": { "nurse": 2, "ghost": 1 } },
        { "id": "q2d", "text": "吃两口叼一块跑到客厅地毯上啃，吃完再回去押镖下一口", "axis": "E", "delta": 3, "points": { "zombie": 2, "clown": 1 } }
      ]
    },
    {
