  "questions": [
    {
      "id": "q1",
      "scene": "下班开门",
      "text": "你开门回家的那一刻，你家猫在干嘛？",
      "options": [
        { "id": "q1a", "text": "门还没开完就冲过来，蹭腿绕圈喵喵念，「你怎么才回来！」", "axis": "A", "delta": 3, "points": { "nurse": 2, "bride": 1, "zombie": 1 } },
        { "id": "q1b", "text": "人影都没有，十分钟后才从床底探出头，假装刚睡醒", "axis": "B", "delta": -3, "points": { "mummy": 2, "ghost": 1 } },
        { "id": "q1c", "text": "迈着小碎步过来看你一眼，「哦，回来了」，转身走猫", "axis": "A", "delta": -3, "points": { "vampire": 2, "pharaoh": 1 } },
        { "id": "q1d", "text": "四脚朝天睡得雷打不动，开门声都叫不醒", "axis": "E", "delta": -3, "points": { "gargoyle": 2, "pharaoh": 1, "bat": 1 } }
      ]
    },
    {
      "id": "q2",
      "scene": "开饭时刻",
      "text": "猫粮倒进碗里 / 撕开零食包装的瞬间——",
      "options": [
        { "id": "q2a", "text": "听见声音瞬移到场，吃完还舔碗、瞪你、拍碗：「就这？」", "axis": "F", "delta": 3, "points": { "pumpkin": 3 } },
        { "id": "q2b", "text": "闻一下就走，「本咪今天心情不适合吃这个」", "axis": "F", "delta": -3, "points": { "pharaoh": 2, "vampire": 1, "witch": 1 } },
        { "id": "q2c", "text": "必须你手喂，边吃边蹭你的手，吃出按摩服务的感觉", "axis": "A", "delta": 3, "points": { "nurse": 2, "ghost": 1 } },
        { "id": "q2d", "text": "吃两口跑去玩，再回来吃两口，少食多餐主义", "axis": "E", "delta": 3, "points": { "zombie": 2, "clown": 1 } }
      ]
    },
    {
      "id": "q3",
      "scene": "半夜的你家",
      "text": "凌晨三点的你家，通常在发生什么？",
      "options": [
        { "id": "q3a", "text": "田径运动会：客厅→卧室→沙发折返跑，自带 BGM 那种", "axis": "E", "delta": 3, "points": { "werewolf": 3, "zombie": 1, "chainsaw": 1 } },
        { "id": "q3b", "text": "它睡在你被子边上/你头上，一夜没挪窝", "axis": "A", "delta": 3, "points": { "bride": 2, "nurse": 1 } },
        { "id": "q3c", "text": "你起夜上厕所，黑暗里一双眼睛亮晶晶盯着你", "axis": "C", "delta": 3, "points": { "witch": 3, "franken": 1 } },
        { "id": "q3d", "text": "「嗖——」一个黑影从柜顶俯冲下来，吓得你瞬间清醒", "axis": "B", "delta": 3, "points": { "bat": 2, "pirate": 1, "clown": 1 } }
      ]
    },
    {
      "id": "q4",
      "scene": "新东西出现",
      "text": "快递箱到货 / 新玩具 / 家里来了陌生人——",
      "options": [
        { "id": "q4a", "text": "快递箱还没拆，猫已经住进去了", "axis": "C", "delta": 3, "points": { "mummy": 2, "franken": 1 } },
        { "id": "q4b", "text": "陌生人一进门，猫直接消失，三小时后才出现", "axis": "B", "delta": -3, "points": { "ghost": 2, "mummy": 1 } },
        { "id": "q4c", "text": "逗猫棒互动到它气喘吁吁，你先累趴", "axis": "E", "delta": 3, "points": { "chainsaw": 2, "zombie": 1, "pirate": 1 } },
        { "id": "q4d", "text": "新东西？「喵都不喵」，眼皮都懒得抬", "axis": "C", "delta": -3, "points": { "vampire": 2, "gargoyle": 1 } }
      ]
    },
    {
      "id": "q5",
      "scene": "像人时刻",
      "text": "你家猫最有「自己是个人」的瞬间：",
      "options": [
        { "id": "q5a", "text": "作息精确得像上班：几点吃饭、几点巡逻、几点蹲窗台看鸟，门清", "axis": "C", "delta": 3, "points": { "franken": 2, "pharaoh": 1, "witch": 1 } },
        { "id": "q5b", "text": "你难过掉眼泪的时候，它会默默走过来挨着你坐", "axis": "A", "delta": 3, "points": { "nurse": 2, "bride": 1 } },
        { "id": "q5c", "text": "完全看不出章法，上一秒舔毛，下一秒原地起飞", "axis": "E", "delta": 3, "points": { "werewolf": 2, "clown": 1, "chainsaw": 1 } },
        { "id": "q5d", "text": "面无表情看你干蠢事，眼里没有一丝波澜", "axis": "D", "delta": -3, "points": { "gargoyle": 2, "vampire": 1 } }
      ]
    },
    {
      "id": "q6",
      "scene": "摸摸敏感度",
      "text": "rua 它的时候——",
      "options": [
        { "id": "q6a", "text": "呼噜发动机秒启动，整个人（猫）化成一滩液体", "axis": "A", "delta": 3, "points": { "nurse": 2, "pumpkin": 1 } },
        { "id": "q6b", "text": "摸两下就跑，过会儿又蹭回来求摸，欲拒还迎", "axis": "D", "delta": 3, "points": { "bride": 2, "ghost": 1 } },
        { "id": "q6c", "text": "全身都是雷区，摸错位置立刻回头「哈——」", "axis": "B", "delta": -3, "points": { "mummy": 2, "ghost": 1 } },
        { "id": "q6d", "text": "摸不摸无所谓，「你自便」", "axis": "A", "delta": -3, "points": { "vampire": 2, "pharaoh": 1, "bat": 1 } }
      ]
    },
    {
      "id": "q7",
      "scene": "玩耍风格",
      "text": "拿逗猫棒/玩具逗它——",
      "options": [
        { "id": "q7a", "text": "战斗模式启动：飞扑、抱咬、锁喉，全家桶式输出", "axis": "E", "delta": 3, "points": { "chainsaw": 2, "zombie": 1, "werewolf": 1 } },
        { "id": "q7b", "text": "有零食参与的游戏才是好游戏，否则免谈", "axis": "F", "delta": 3, "points": { "pumpkin": 2, "pirate": 1 } },
        { "id": "q7c", "text": "你玩你的，它睡它的，「人类真无聊」", "axis": "E", "delta": -3, "points": { "gargoyle": 2, "bat": 1 } },
        { "id": "q7d", "text": "玩着玩着突然锁定空气中的某个敌人，瞳孔地震", "axis": "D", "delta": 3, "points": { "clown": 2, "witch": 1 } }
      ]
    },
    {
      "id": "q8",
      "scene": "抢地盘",
      "text": "你家的日常「领土争端」——",
      "options": [
        { "id": "q8a", "text": "你刚起身，座位立刻易主；你的纸箱就是它的宫殿", "axis": "B", "delta": 3, "points": { "pharaoh": 2, "pirate": 1 } },
        { "id": "q8b", "text": "盯上你碗里的饭：人饭怎么都比猫饭香", "axis": "F", "delta": 3, "points": { "pumpkin": 2, "werewolf": 1 } },
        { "id": "q8c", "text": "你加班它踩键盘，认真帮你「写报告」", "axis": "C", "delta": 3, "points": { "franken": 2, "witch": 1 } },
        { "id": "q8d", "text": "远远跟着你巡视全屋，保持一米社交距离", "axis": "A", "delta": -3, "points": { "bat": 2, "vampire": 1 } }
      ]
    },
    {
      "id": "q9",
      "scene": "外出体检",
      "text": "带出门（体检/洗澡）——",
      "options": [
        { "id": "q9a", "text": "航空箱前上演消失术，塞进去后一路嚎出一部大戏", "axis": "D", "delta": 3, "points": { "clown": 2, "bride": 1 } },
        { "id": "q9b", "text": "到了医院全程淡定，医生都夸「好乖」", "axis": "B", "delta": 3, "points": { "gargoyle": 2, "pirate": 1 } },
        { "id": "q9c", "text": "出门全程发抖装隐形，恨不得嵌进航空箱底", "axis": "B", "delta": -3, "points": { "ghost": 2, "mummy": 1 } },
        { "id": "q9d", "text": "一到新地方就开始巡逻，占领每个制高点", "axis": "C", "delta": 3, "points": { "pirate": 3, "franken": 1 } }
      ]
    },
    {
      "id": "q10",
      "scene": "镜头感",
      "text": "举起手机对准它——",
      "options": [
        { "id": "q10a", "text": "镜头一对就摆好，天生平面模特", "axis": "D", "delta": 3, "points": { "bride": 2, "clown": 1 } },
        { "id": "q10b", "text": "拍一百张，99 张糊的，剩下 1 张是屁股", "axis": "E", "delta": 3, "points": { "zombie": 2, "chainsaw": 1 } },
        { "id": "q10c", "text": "死活不看镜头，镜头感为负数", "axis": "D", "delta": -3, "points": { "gargoyle": 1, "bat": 1, "witch": 1 } },
        { "id": "q10d", "text": "凑过来闻镜头/拍镜头，拍摄到此结束", "axis": "C", "delta": 3, "points": { "franken": 2, "witch": 1 } }
      ]
    }
